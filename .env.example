# Copy this file to .env and fill in whichever provider(s) you use.
# You only need one of these to run the pipelines.

# Tripo AI: https://platform.tripo3d.ai/api-keys (key starts with tsk_)
TRIPO_API_KEY=tsk_your_tripo_api_key_here

# Meshy AI: https://app.meshy.ai -> Settings -> API Access
MESHY_API_KEY=your_meshy_api_key_here
